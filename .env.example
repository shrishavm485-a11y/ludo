# Copy to .env for local use. Render sets PORT itself. Nothing here is a secret the frontend needs.
PORT=3000
# Set to 0 only if you run the server directly on the internet without a proxy (Render needs the default).
TRUST_PROXY=1
# Only if the frontend is hosted on a different origin than this server (comma separated list):
# CLIENT_ORIGIN=https://my-frontend.example.com
# Frontend build-time variable, only for a split deployment:
# VITE_SERVER_URL=https://my-server.example.com
