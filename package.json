{
  "name": "ludo-mayhem",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LUDO MAYHEM: multiplayer Ludo for 2-10 players (online rooms + offline pass-and-play)",
  "engines": { "node": ">=20" },
